# 复制本文件为 .env 并填入真实值（.env 不要提交到 git）
#
# 大模型 API（OpenAI 兼容协议，DeepSeek / 硅基流动 SiliconFlow 均可用）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
#
# 硅基流动 SiliconFlow 示例：
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3
#
# LangSmith 可观测性（可选；不配置则静默跳过，不影响运行）
# 打开后可在 smith.langchain.com 看到每次任务的完整 trace（工具调用 / 耗时 / token）。
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxx
# LANGCHAIN_PROJECT=abaqus-agent
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
